# Copie para .env (o .env não vai para o git) e preencha.

# Porta em que o ESP32 e o painel falam com este servidor.
PORT=3000

# Endereço do backend, sem barra no fim. Vazio = só o painel da bancada, nada vai ao backend.
# No notebook com o Docker Compose: http://localhost:8080
BACKEND_URL=

# Chave do sensor, gerada pelo admin em POST /admin/sensores/{id}/chave.
# Nunca no código, em print ou no grupo de mensagens. Vazou? Gere outra.
SENSOR_CHAVE=

# A cada quantos segundos a mediana das leituras vai ao backend.
INTERVALO_REPASSE_S=30
