# Copie para .env.local e ajuste. Tudo é opcional.
# Endereço do app publicado: é para onde vão os botões e o que aparece no telefone da página.
NEXT_PUBLIC_URL_APP=https://sima-sp.github.io/sima-sp/app/
# Endereço público desta página: a imagem de compartilhamento precisa do endereço completo.
NEXT_PUBLIC_URL_SITE=https://sima-sp.github.io/sima-sp/
# Subpasta em que a página é publicada. Vazio = raiz do endereço.
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_INSTITUICAO=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_REPOSITORIO=
# Vídeo da demonstração e texto do TCC, na seção "Quem fez". Vazio = o link não aparece.
NEXT_PUBLIC_URL_VIDEO=
NEXT_PUBLIC_URL_TCC=
