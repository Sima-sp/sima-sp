# Copie para infra/.env e preencha. O .env não vai para o git: nenhum segredo real fica no repositório.
# Atalho: ./gerar-env.sh cria o .env com senhas e chaves novas.

# Banco (MySQL). Senhas novas, só deste computador.
DB_USERNAME=simasp_user
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Chave do token de login: Base64, 32 bytes ou mais. Gere com: openssl rand -base64 48
JWT_SECRET=

# Primeiro administrador, criado ao subir se o e-mail ainda não existir (senha com 8 ou mais caracteres).
# O admin cadastra o bueiro_01, gera a chave do sensor e liga a chuva de teste.
ADMIN_EMAIL=
ADMIN_SENHA=

# Chuva de teste (POST /admin/demonstracao/iniciar). Ligada no notebook da banca; desligue na hospedagem.
IA_DEMONSTRACAO=true

# Notificação no celular (Web Push). Gere uma vez com: npx web-push generate-vapid-keys
# Vazias, o resto funciona e o app só não se inscreve no push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTATO=mailto:contato@simasp.local

# Origens do app que podem chamar o backend pelo navegador, separadas por vírgula.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://sima-sp.github.io

# Porta do backend neste computador.
BACKEND_PORTA=8080
